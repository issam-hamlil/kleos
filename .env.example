# ---------------------------------------------------------------------------
# Kleos configuration. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# Public HTTPS origin of your Cloudflare Tunnel, no trailing slash.
# Used for (a) the YouTube WebSub callback and (b) serving video to Instagram.
PUBLIC_BASE_URL=https://kleos.example.com

# Random string. Signs WebSub payloads so only YouTube's hub can drive the app.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBSUB_SECRET=

# Comma-separated YouTube channel IDs (the UC... form, not the @handle).
YOUTUBE_CHANNEL_IDS=

# Never publish anything older than this. Protects against the catch-up poller
# posting stale highlights after the PC has been off overnight.
STALENESS_MINUTES=180

# Master kill switch. Set false to make the pipeline fetch but never publish.
PUBLISH_ENABLED=true

# Appended to every caption.
CAPTION_SUFFIX=

# --- Meta (Facebook Page + Instagram) --------------------------------------
# One long-lived Page access token covers both.
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0

FACEBOOK_ENABLED=true
FACEBOOK_PAGE_ID=
FACEBOOK_MAX_DURATION_S=7200

INSTAGRAM_ENABLED=true
INSTAGRAM_USER_ID=
INSTAGRAM_MAX_DURATION_S=900

# --- X / Twitter -----------------------------------------------------------
X_ENABLED=true
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_MAX_DURATION_S=140
